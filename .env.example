# =============================================
# AI 語音會議助理 - 環境變數設定範例
# 複製此檔案為 .env 並填入你的 API Key
# =============================================

# ── Google Gemini AI ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# 雙模型架構：音訊轉逐字稿使用轉錄模型；完整逐字稿產生摘要/決議/待辦使用摘要模型。
TRANSCRIPTION_MODEL=gemini-3.1-flash-lite
# Used after a transcript segment still fails deterministic/audio-backed quality
# checks, a major numeric/repetition loop, or when the primary model has a
# temporary 429/5xx/timeout failure.
# Leave equal to TRANSCRIPTION_MODEL to disable the distinct-model fallback.
TRANSCRIPTION_RECOVERY_MODEL=gemini-3.5-flash
# Used by manual "完整重跑" and by a meeting-wide rerun only for segments with
# saved, audio-confirmed critical defects. It makes one short-chunk pass with
# this model instead of repeating the primary model. Set equal to
# TRANSCRIPTION_MODEL to keep the original model for full reruns.
TRANSCRIPTION_FULL_RERUN_MODEL=gemini-3.5-flash
# Used only when a user manually runs "語意檢核". It reviews existing text for
# clearly broken phrasing, marks review locations, and never rewrites content.
TRANSCRIPT_SEMANTIC_REVIEW_MODEL=gemma-4-31b-it
TRANSCRIPT_SEMANTIC_REVIEW_FALLBACK_MODEL=gemini-3.5-flash
# Gemini SDK request timeout in seconds.  A stalled upstream call is returned
# to the persistent queue for retry instead of leaving a worker stuck forever.
GENAI_HTTP_TIMEOUT_SECONDS=180
SUMMARY_MODEL=gemma-4-31b-it
SUMMARY_FALLBACK_MODEL=gemini-3.1-flash-lite
# Used only by high-quality summary reruns for second-stage evidence verification.
SUMMARY_VERIFIER_MODEL=gemini-3.5-flash

# Browser recording profiles (free local compression; settings are exposed via /config)
RECORDING_AUDIO_BITRATE=48000
RECORDING_AUDIO_SAMPLE_RATE=24000
RECORDING_AUDIO_CHANNELS=1
RECORDING_COMPACT_AUDIO_BITRATE=32000
RECORDING_COMPACT_AUDIO_SAMPLE_RATE=16000
RECORDING_VIDEO_BITRATE=1000000
RECORDING_VIDEO_FPS=15

# ── LINE Bot (Phase 3) ────────────────────────────────
# 取得方式：LINE Developers Console → 您的 Channel → Basic settings
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 取得方式：LINE Developers Console → 您的 Channel → Messaging API → Channel access token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ── 本機後端安全設定 ──────────────────────────────────
# /line-webhook 保持公開給 LINE 平台呼叫，並由 LINE 簽章驗證。
# 區網與公開入口預設都需有效 bootstrap/API session；不要把區網視為身分。
APP_API_KEY=change_me_to_a_long_random_value

# Enable persisted users, roles, and mutation audit after seeding the local user.
MEETING_AUTH_ENABLED=0
# Local loopback and valid API/bootstrap sessions use this persisted app_users
# identity. Seed it as an admin before enabling RBAC.
MEETING_AUTH_LOCAL_SESSION_USER=local-admin@meeting-assistant.local
MEETING_AUTH_USER_HEADER=X-Meeting-User
MEETING_AUTH_DEFAULT_ROLE=viewer
# Only these reverse-proxy networks may supply MEETING_AUTH_USER_HEADER.
MEETING_AUTH_TRUSTED_PROXY_NETWORKS=127.0.0.0/8,::1/128

# 上傳檔案大小上限，單位 MB。
MAX_UPLOAD_MB=500

# 任務自動重試設定。503/429/UNAVAILABLE 等暫時性錯誤會等待一段時間再重試。
JOB_QUEUE_MAX_ATTEMPTS=5
# Deterministic transcript-quality failures stop earlier; transient errors keep
# JOB_QUEUE_MAX_ATTEMPTS and exponential backoff.
JOB_QUEUE_QUALITY_MAX_ATTEMPTS=3
JOB_QUEUE_LEASE_SECONDS=90
JOB_QUEUE_HEARTBEAT_SECONDS=15
JOB_QUEUE_TRANSIENT_RETRY_DELAY_SECONDS=30
# 暫時性錯誤採指數退避：第 1 次 30 秒、第 2 次 60 秒，最多等待 300 秒。
JOB_QUEUE_TRANSIENT_RETRY_BACKOFF_MULTIPLIER=2
JOB_QUEUE_TRANSIENT_RETRY_MAX_DELAY_SECONDS=300
AUDIO_PREPROCESSING=1
AUDIO_MIN_DBFS=-55
AUDIO_NORMALIZE_BELOW_DBFS=-28
# 首次轉錄遇到爆音、高語音密度且動態範圍過大的錄音時，建立語音聚焦暫存副本；原始檔不會修改。
AUDIO_INITIAL_SPEECH_FOCUS=1
# 有效語音至少佔此比例才啟用首次語音聚焦，避免處理一般安靜或間歇性錄音。
AUDIO_INITIAL_SPEECH_FOCUS_MIN_ACTIVE_RATIO=0.55
# 首次轉錄僅在接近 0 dBFS 的實際爆音時才建立副本；已確認轉錄異常的補救仍使用下方較寬的 -0.5 dBFS 門檻。
AUDIO_INITIAL_SPEECH_FOCUS_CLIP_DBFS=-0.1
# 語音聚焦副本的切段維持無損 FLAC 上傳，避免提升後再次 MP3 壓縮；一般錄音仍維持較小 MP3。
SPEECH_FOCUS_LOSSLESS_UPLOAD=1
# 語音聚焦的本機 ffmpeg 最長處理秒數。長錄音的濾波與無損轉檔可能超過 90 秒；設為 90-600。
SPEECH_FOCUS_TIMEOUT_SECONDS=180
# 僅在已偵測到轉錄異常而重跑的分段中，針對貼近 0 dBFS 且動態範圍過大的音訊建立語音聚焦暫存副本；原始檔不會修改。
RECOVERY_SPEECH_FOCUS=1
RECOVERY_SPEECH_FOCUS_CLIP_DBFS=-0.5
RECOVERY_SPEECH_FOCUS_MIN_DYNAMIC_RANGE_DB=14
# 補救副本的人聲目標響度與真實峰值上限；系統以 24 kHz 無損 FLAC 暫存，保留已濾出的人聲頻帶，僅影響暫存副本，不會改寫原始錄音。
RECOVERY_SPEECH_FOCUS_TARGET_LUFS=-19
RECOVERY_SPEECH_FOCUS_TRUE_PEAK_DB=-1.5
SEGMENT_SILENCE_WINDOW_SECONDS=45
SEGMENT_OVERLAP_SECONDS=2
# 相鄰分段只允許短暫重疊；完整逐字稿若跨段倒退超過此秒數，會停止產出摘要並要求重跑問題段。
TRANSCRIPT_CROSS_SEGMENT_TIMESTAMP_REGRESSION_TOLERANCE_SECONDS=10
# 單一分段內若時間碼大幅倒退，也會完整重轉該段；小幅模型時間估算誤差仍保留。
TRANSCRIPT_INTRA_SEGMENT_TIMESTAMP_REGRESSION_TOLERANCE_SECONDS=15
# 後續分段會利用重疊音訊及上一段的匿名標籤維持發言者編號一致；不會傳入前段說話內容。
SPEAKER_BOUNDARY_ANCHOR=1
SPEAKER_BOUNDARY_ANCHOR_MAX_AGE_SECONDS=45
# 高語音密度的長音檔，首次轉錄會先採較短分段，避免模型提早結束而漏字。
# 指定分段重跑與僅重整摘要會維持原有切點，確保分段編號不會錯位。
INITIAL_DENSE_AUDIO_SPLIT=1
INITIAL_DENSE_AUDIO_SPLIT_MINUTES=5
# 只有幾乎持續發言的高風險區塊才會再縮短；一般高密度區段仍維持約 5 分鐘。
INITIAL_VERY_DENSE_AUDIO_SPLIT_MINUTES=3
# 連續發言且接近滿刻度峰值的錄音，首次轉錄即採較短分段，降低爆音遮蔽安靜發言造成的漏字風險。
INITIAL_CLIPPED_DENSE_AUDIO_SPLIT=1
INITIAL_CLIPPED_DENSE_AUDIO_SPLIT_MINUTES=3
# 首次短切段只在接近 0 dBFS 的實際爆音時觸發；正常高密度錄音仍維持約 5 分鐘，減少不必要的交界。
INITIAL_CLIPPED_DENSE_AUDIO_CLIP_DBFS=-0.1
INITIAL_DENSE_AUDIO_MIN_ACTIVE_SECONDS=180
INITIAL_DENSE_AUDIO_MIN_ACTIVE_RATIO=0.55
INITIAL_VERY_DENSE_AUDIO_MIN_ACTIVE_RATIO=0.65
# 整場未達高密度時，仍逐一檢查每個標準分段；只把真正連續發言的區塊縮短，兼顧品質與處理量。
INITIAL_DENSE_AUDIO_PER_SEGMENT_SPLIT=1
# 只有首次轉錄被高密度規則縮短的來源或局部討論段，才在交界保留較長語音上下文，降低連續句子剛好被切斷而漏字的風險。
INITIAL_DENSE_AUDIO_SEGMENT_OVERLAP_SECONDS=5
# 補救用小段在交界前後保留的語音上下文秒數；合併時只移除完全相同的重疊發言。
RECOVERY_SUBSEGMENT_OVERLAP_SECONDS=2
# 僅在極端缺字時使用的短補救小段，保留較長交界語境，降低連續發言剛好落在 30 秒切點時的漏字風險。
RECOVERY_SHORT_SUBSEGMENT_MAX_SECONDS=30
RECOVERY_SHORT_SUBSEGMENT_OVERLAP_SECONDS=4
# 輸出組裝時，在切點前後此秒數內移除下一段開頭可安全判定為重複的發言，避免音訊重疊造成逐字稿重複。
SEGMENT_OVERLAP_DEDUPLICATION_WINDOW_SECONDS=15
# 同一發言者且除了「好／那／對」等開頭口語詞外完全相同的交界發言，也可安全去重；關閉後只移除完全相同內容。
SEGMENT_OVERLAP_LEADING_FILLER_DEDUPLICATION=1
# 在長時間未標時間戳的區段，先以本機音訊確認是否仍有說話聲；確認有聲才自動細切重轉。
TRANSCRIPT_SPEECH_GAP_VALIDATION=1
TRANSCRIPT_SPEECH_GAP_SECONDS=60
TRANSCRIPT_SPEECH_GAP_MIN_ACTIVE_SECONDS=12
TRANSCRIPT_SPEECH_GAP_MIN_ACTIVE_RATIO=0.25
# 有效語音很密集但逐字稿文字量異常偏低時，阻擋摘要並以小段重跑；可設為 0 停用。
TRANSCRIPT_SPEECH_DENSITY_VALIDATION=1
TRANSCRIPT_SPEECH_DENSITY_MIN_ACTIVE_SECONDS=90
# 補救用短分段會依長度下修有效語音門檻；門檻不會高於該小段本身，避免 30 秒小段因不可能達到 45 秒語音而漏檢。
TRANSCRIPT_SPEECH_DENSITY_SHORT_SEGMENT_MIN_ACTIVE_SECONDS=15
TRANSCRIPT_SPEECH_DENSITY_MIN_ACTIVE_RATIO=0.45
TRANSCRIPT_SPEECH_DENSITY_MIN_CHARS_PER_ACTIVE_SECOND=2.5
# 即使整段文字總量正常，也檢查長分段內是否有持續有聲卻局部漏字的區間；命中時會標出問題時間並優先局部補救。
TRANSCRIPT_LOCAL_DENSITY_VALIDATION=1
TRANSCRIPT_LOCAL_DENSITY_WINDOW_SECONDS=90
TRANSCRIPT_LOCAL_DENSITY_STEP_SECONDS=45
TRANSCRIPT_LOCAL_DENSITY_MIN_ACTIVE_SECONDS=35
TRANSCRIPT_LOCAL_DENSITY_MIN_ACTIVE_RATIO=0.45
TRANSCRIPT_LOCAL_DENSITY_MIN_CHARS_PER_ACTIVE_SECOND=1.5
TRANSCRIPT_LOCAL_DENSITY_MAX_RANGES=4
# 每個分段最多保留多少個已由本機音訊活動確認的漏字位置；超過局部補救上限時會改用穩定小段重跑。
TRANSCRIPT_SPEECH_GAP_MAX_RANGES=6
# 局部補救缺口時額外帶入前後語境秒數；只會合併缺口附近的時間戳內容。
TRANSCRIPT_REPAIR_CONTEXT_SECONDS=6
# 已證實的漏字區間若僅相隔短時間，合併成同一個補救窗口，以保留其他正確內容並避免整段重跑。
TRANSCRIPT_REPAIR_COALESCE_GAP_SECONDS=20
# 局部補救音檔達此秒數時，直接先切成較穩定的小段轉錄，避免長缺口再次截斷。
TRANSCRIPT_REPAIR_DIRECT_SPLIT_SECONDS=180
# 已確認有語音卻漏字、或有多個可定位異常時，穩定重跑的目標切段秒數。
TRANSCRIPT_CONFIRMED_GAP_RECOVERY_SECONDS=180
# 超過局部補救上限的多點「時間缺口」，或指定重跑時已由音訊證實文字量偏低的分段，
# 直接使用更短的小段，避免先以 180 秒失敗後重做。若已精確定位局部漏字、重複或數列異常，
# 系統會優先改用 TRANSCRIPT_LOCAL_REPAIR_RECOVERY_SECONDS。
TRANSCRIPT_MULTI_GAP_RECOVERY_SECONDS=120
# 已定位的局部漏字、重複或數列異常，局部補救時優先使用的更短切段秒數。
TRANSCRIPT_LOCAL_REPAIR_RECOVERY_SECONDS=60
# 只有本機音訊已確認局部有效語音充足、但文字量極端偏低時，改用更短的小段重跑。
# 預設門檻為 <= 0.5 字/有效語音秒；一般局部漏字仍使用上方 60 秒設定。
TRANSCRIPT_SEVERE_LOCAL_DENSITY_MAX_CHARS_PER_ACTIVE_SECOND=0.5
TRANSCRIPT_SEVERE_LOCAL_DENSITY_RECOVERY_SECONDS=30
# 首次轉錄或使用者重跑發現嚴重漏字、數列延伸或長重複迴圈時，自動改用完整替換與較強模型，避免保留不可靠舊句。
TRANSCRIPT_CRITICAL_RERUN_ESCALATION=1
# 已由本機音訊確認的單一持續語音缺口達此秒數時，直接完整重跑該段；60 秒以上的漏轉通常不宜與舊稿局部拼接。
TRANSCRIPT_CRITICAL_SUSTAINED_GAP_SECONDS=60
# 連續重複達此數量時，選擇重跑會完整替換該段；較短重複仍先局部補救。
TRANSCRIPT_CRITICAL_REPETITION_MIN_TURNS=8
# 偵測同一發言者持續輸出短而懸空的片段。命中時會以較短小段交由備援模型補救一次；
# 若仍未改善則保留品質警示，不會無限自動重跑。
TRANSCRIPT_FRAGMENTATION_VALIDATION=1
TRANSCRIPT_FRAGMENTATION_MAX_TURN_CHARS=12
TRANSCRIPT_FRAGMENTATION_MIN_SHORT_TURNS=10
TRANSCRIPT_FRAGMENTATION_MIN_SHORT_RATIO=0.65
TRANSCRIPT_FRAGMENTATION_MIN_DOMINANT_SPEAKER_RATIO=0.80
TRANSCRIPT_FRAGMENTATION_MIN_DANGLING_SHORT_RATIO=0.40
TRANSCRIPT_FRAGMENTATION_WINDOW_SECONDS=120
TRANSCRIPT_FRAGMENTATION_MIN_SPAN_SECONDS=60
# 偵測同一發言者在短時間內反覆輸出高度相似長句；命中時只補救該時間範圍。
TRANSCRIPT_SHORT_CYCLE_DUPLICATE_VALIDATION=1
TRANSCRIPT_SHORT_CYCLE_DUPLICATE_MIN_CHARS=20
TRANSCRIPT_SHORT_CYCLE_DUPLICATE_MIN_SIMILARITY=0.88
TRANSCRIPT_SHORT_CYCLE_DUPLICATE_MIN_TURNS=3
TRANSCRIPT_SHORT_CYCLE_DUPLICATE_WINDOW_TURNS=4
TRANSCRIPT_SHORT_CYCLE_DUPLICATE_MAX_SPAN_SECONDS=30

# 允許的瀏覽器來源，以逗號分隔。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# 是否允許同 Wi-Fi / 信任本機網段直接開啟 Web 介面。
# 安全預設 0；只有明確接受區網內匿名存取風險時才改為 1。
MEETING_ASSISTANT_TRUST_LOCAL_NETWORK=0

# ── ngrok / LINE Webhook 開發 tunnel ─────────────────
# 一鍵啟動預設會嘗試啟動 ngrok；若要停用請設為 0。
MEETING_ASSISTANT_NGROK=1
# Unattended Windows service/task launches should set this to 0.
MEETING_ASSISTANT_OPEN_BROWSER=1
# Restart a crashed Uvicorn child with bounded exponential backoff.
MEETING_ASSISTANT_AUTO_RESTART=1
MEETING_ASSISTANT_MAX_RESTARTS=5
MEETING_ASSISTANT_RESTART_DELAY_SECONDS=2
MEETING_ASSISTANT_RESTART_RESET_SECONDS=300
MEETING_ASSISTANT_LOG_MAX_BYTES=20971520
MEETING_ASSISTANT_LOG_KEEP=3
# Health becomes degraded before local storage silently exhausts capacity.
MEETING_DATABASE_MAX_BYTES=2147483648
MEETING_SOURCE_MEDIA_MAX_BYTES=21474836480
MEETING_BACKUP_MAX_BYTES=21474836480
MEETING_MIN_FREE_DISK_BYTES=5368709120

# 若使用 ngrok reserved/static domain，填入不含 /line-webhook 的公開 URL。
# 留空時，一鍵啟動會嘗試從 LINE Console 既有 Webhook URL 自動推回公開 URL。
MEETING_ASSISTANT_NGROK_URL=

# ngrok 本機狀態 API；前端維運面板會用後端 /metrics 顯示 tunnel 狀態。
MEETING_ASSISTANT_NGROK_API_URL=http://127.0.0.1:4040/api/tunnels

# ── 本機資料夾路徑 ───────────────────────────────────
DB_PATH=./meetings.db
MEETING_TEMP_DIR=./temp
MEETING_OUTPUT_DIR=./output
MEETING_ATTACHMENT_DIR=./output/attachments
MEETING_BACKUP_DIR=./backups
# Optional distinct disk/share. When set, each verified v2 record snapshot is
# copied atomically and verified again. Do not point this at MEETING_BACKUP_DIR.
MEETING_OFFSITE_BACKUP_DIR=
FULL_SNAPSHOT_MIN_INTERVAL_HOURS=24

# Word 匯出範本路徑。此檔案含公司表單樣式時請保留在本機，不提交到 Git。
MEETING_DOCX_TEMPLATE_PATH=./4-QA-005 V01 會議紀錄.docx
